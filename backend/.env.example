# Copy to .env (local) or set these in your hosting dashboard (server).
# Make a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-text

# Websites allowed to call this API, separated by commas
FRONTEND_ORIGINS=https://auto-connect-frontend-jqmh4wqsf.vercel.app/

# Optional: creates the first admin automatically when the server starts
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
# ADMIN_PHONE=9000000000

# Optional: where the database file lives (use a persistent disk on a server)
# DATABASE_PATH=
